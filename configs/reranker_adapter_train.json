{
  "experiment_id": "exp-reranker-adapter-v1",
  "base_model": "Qwen/Qwen3-Reranker-0.6B",
  "dataset_manifest": "datasets/ambedkar_retrieval_benchmark_v1.0.0.json",
  "training_split": "train",
  "validation_split": "val",
  "hardware_requirements": {
    "recommended_gpu": "NVIDIA A10G / RTX 4090",
    "minimum_vram_gb": 16,
    "local_execution": "LOCAL TRAINING NOT FEASIBLE (6GB VRAM Insufficient)"
  },
  "hyperparameters": {
    "learning_rate": 1e-5,
    "batch_size": 8,
    "gradient_accumulation_steps": 4,
    "epochs": 3,
    "warmup_ratio": 0.1,
    "fp16": true,
    "adapter_type": "LoRA",
    "lora_r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05
  },
  "loss_function": "BCEWithLogitsLoss",
  "evaluation_metrics": ["MRR", "nDCG@10", "hard_negative_discrimination_gap"],
  "early_stopping": {
    "patience": 2,
    "metric": "eval_mrr",
    "mode": "max"
  }
}
