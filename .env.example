# Database (Turso / libSQL)
TURSO_DATABASE_URL=libsql://ambedkar-archive-deadrobo.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Storage Backend
STORAGE_BACKEND=LOCAL
STORAGE_ROOT=storage/local
# S3 / Cloudflare R2 Future Config:
# STORAGE_S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# STORAGE_S3_BUCKET=ambedkar-archive
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Model Provider & AI Models
MODEL_PROVIDER=local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
GENERATION_MODEL=Qwen/Qwen3-VL-2B-Instruct-AWQ
VISION_MODEL=Qwen/Qwen3-VL-2B-Instruct-AWQ

# Cloud Model Keys (Groq Primary / Gemini Fallback)
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=

# Microservices
BACKEND_MAIN_URL=http://localhost:8000
BACKEND_INDIC_URL=http://localhost:8001
BACKEND_OCR_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3000

# Security & CORS
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_KEY
CORS_ORIGINS=["http://localhost:3000"]

# ── TTS Providers (server-side only — NEVER expose to frontend) ──────────────
# Sarvam AI TTS (using Shubh voice model) — for Indic languages: bn, ta, gu, te, kn, ml, mr, pa, od
SARVAM_API_KEY=
SARVAM_SPEAKER=shubh
SARVAM_MODEL=bulbul:v3

# ElevenLabs — for English and Hindi
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# TTS provider routing (comma-separated short language codes)
TTS_ELEVENLABS_LANGUAGES=en,hi
TTS_SARVAM_LANGUAGES=bn,ta,gu,te,kn,ml,mr,pa,od

# Optional: language-specific speaker overrides (defaults to "shubh" across all languages)
# TTS_SARVAM_SPEAKER_MAP=
