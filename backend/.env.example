# ============================================================
# BACKEND ENVIRONMENT — venv-main (Python 3.14)
# Copy to .env and fill in actual values
# NEVER commit .env to git
# ============================================================

APP_NAME=ambedkar-heritage-api
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET

# Turso Database
# Development (local file):
TURSO_DB_URL=file:storage/turso/ambedkar_dev.db
# Production (Turso Cloud):
# TURSO_DB_URL=libsql://ambedkar-archive.turso.io
# TURSO_AUTH_TOKEN=

# Storage
STORAGE_BACKEND=LOCAL
STORAGE_LOCAL_ROOT=storage/local
# Future S3/R2:
# STORAGE_S3_BUCKET=ambedkar-archive
# STORAGE_S3_ENDPOINT=https://{account}.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# AI Models (local)
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
AI_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
AI_VL_MODEL=Qwen/Qwen3-VL-2B-Instruct-AWQ
AI_MODEL_CACHE_DIR=models/cache
AI_EMBEDDING_DIMENSION=1024
AI_EMBEDDING_BATCH_SIZE=16
AI_VRAM_EVICT_THRESHOLD_GB=1.0

# Cloud LLM (Groq Primary / Gemini Fallback)
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=

# Indic Microservice
INDIC_SERVICE_URL=http://localhost:8001
OCR_SERVICE_URL=http://localhost:8002

# IIIF
IIIF_BASE_URL=http://localhost:8000/iiif

# Auth
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO

# ── TTS Providers (server-side only — NEVER expose to frontend) ──────────────
# Sarvam AI TTS (using Shubh voice model) — for Indic languages: bn, ta, gu, te, kn, ml, mr, pa, od
SARVAM_API_KEY=
SARVAM_SPEAKER=shubh
SARVAM_MODEL=bulbul:v3

# ElevenLabs — for English and Hindi
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# TTS provider routing (comma-separated short language codes)
TTS_ELEVENLABS_LANGUAGES=en,hi
TTS_SARVAM_LANGUAGES=bn,ta,gu,te,kn,ml,mr,pa,od

# Optional: language-specific speaker overrides (defaults to "shubh" across all languages)
# TTS_SARVAM_SPEAKER_MAP=
