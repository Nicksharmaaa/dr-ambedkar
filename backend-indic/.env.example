# ============================================================
# AMBEDKAR HERITAGE INTELLIGENCE SYSTEM
# Indic AI Microservice Environment Variables Template
# Runs in Python 3.10 environment
# ============================================================

APP_NAME=ambedkar-indic-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001

# IndicTrans2
INDICTRANS2_MODEL_DIR=../models/cache/indictrans2
INDICTRANS2_DEVICE=cuda

# IndicConformer (ASR)
INDICCONFORMER_MODEL_DIR=../models/cache/indicconformer
INDICCONFORMER_DEVICE=cuda

# IndicF5 (TTS)
INDICF5_MODEL_DIR=../models/cache/indicf5
INDICF5_DEVICE=cuda

# Default language settings
DEFAULT_SOURCE_LANG=en
DEFAULT_TARGET_LANG=mr
SUPPORTED_LANGUAGES=en,hi,mr,te,ta,bn,gu,kn,ml,or,pa,as,ur,ne,sd,mai,kok,sat,doi,mni,ks,bho

LOG_LEVEL=INFO
